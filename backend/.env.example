# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_DB_URL=postgresql://postgres:password@localhost:5432/postgres

# Backend
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
