# Plantilla de variables de entorno del frontend.
# Copia a .env.local y reemplaza los valores. Nunca versiones .env.local (NFR-008).

# URL base de la API del backend (incluye /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google Identity Services — mismo Client ID que GOOGLE_CLIENT_ID en backend/.env.
# No es un secreto: se usa en el navegador para iniciar el flujo de Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Token MockUSDT en HSK Chain testnet (docs/frontend_spec.md §2). No es un secreto:
# es la dirección pública del contrato del token, usada para leer saldo/allowance
# (UC-009) y para wallet_watchAsset. La dirección de CauseVault no se configura
# aquí: llega en cada instrucción de firma (`contract`).
NEXT_PUBLIC_TOKEN_ADDRESS=0xD6D6fbbcAe342788DCC18fF2b1cd692c8b8837ec
